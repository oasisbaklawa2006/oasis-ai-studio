{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.*.config.ts",
    "scripts/**/*.{js,mjs,ts}",
    "src/**/*.{test,spec}.{ts,tsx}",
    "src/components/ui/**/*.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{js,mjs,ts}", "e2e/**/*.ts"],
  "ignore": ["src/integrations/supabase/types.ts", "src/vite-env.d.ts"],
  "ignoreDependencies": ["autoprefixer", "tailwindcss-animate", "@tesseract.js-data/eng"]
}
